# 服务端口
PORT=3003

# 邮箱配置
SMTP_HOST=
SMTP_PORT=465
EMAIL_ACCOUNT=
EMAIL_key=
EMAIL_SECURE=true

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379

# 数据库配置
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=new-rabbit-back

# Token 配置
TOKEN_SECRET_KEY=

# API Key 配置
APIKEY=

# bcrypt 加密轮数
SALTROUNDS=10

# UAPI 天气/区划等接口密钥
UAPIPRO_APIKEY=

# 雪花ID 配置
# 单体架构下固定即可，只要不重复
SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_CENTER_ID=1
# 自定义纪元时间（设为项目启动时间，让ID更短）
SNOWFLAKE_EPOCH=1704067200000
# 字符串模式（强烈建议，避免 js Number 精度丢失）
SNOWFLAKE_STRING_MODE=true

# 阿里百炼 API
ALI_DASHSCOPE_API_KEY=
ALI_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 白山智算 API
BAISHAN_DASHSCOPE_API_KEY=
BAISHAN_DASHSCOPE_BASE_URL=https://api.edgefn.net/v1

# 七牛云服务配置
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=

# ChromaDB 向量库配置
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=ecommerce_knowledge_base

# 七牛 API（可选，用于 LLM 通过七牛网关调用）
QINIU_DASHSCOPE_API_KEY=
QINIU_DASHSCOPE_BASE_URL=

# Huggingface（可选）
HUGGINGFACE_DASHSCOPE_API_KEY=
HUGGINGFACE_DASHSCOPE_BASE_URL=

# GLM 配置（可选）
GLM_DASHSCOPE_API_KEY=
GLM_DASHSCOPE_BASE_URL=

# 模型
MODEL_NAME=
VISION_MODEL_NAME=
REPORT_MODEL_NAME=

# LangGraph PostgreSQL Checkpoint
LANGGRAPH_POSTGRES_HOST=localhost
LANGGRAPH_POSTGRES_PORT=5432
LANGGRAPH_POSTGRES_DATABASE=langgraph
LANGGRAPH_POSTGRES_USER=postgres
LANGGRAPH_POSTGRES_PASSWORD=postgres

# PostgreSQL Connection URL
LANGGRAPH_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/langgraph

# LangGraph 配置
USE_LANGGRAPH=true
LANGGRAPH_RECURSION_LIMIT=8
AGENT_MAX_STEPS=3

# 腾讯云 OCR 密钥
TENCENT_OCR_SECRET_ID=
TENCENT_OCR_SECRET_KEY=

