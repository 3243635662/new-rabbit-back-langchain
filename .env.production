# ═══════════════════════════════════════════════
# 生产环境变量 — 部署前必须修改占位值
# ═══════════════════════════════════════════════

PORT=3003

# ─── MySQL ───
MYSQL_ROOT_PASSWORD=替换为强密码
MYSQL_USER=root
MYSQL_PASSWORD=替换为强密码
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=new-rabbit-back

# ─── Redis ───
REDIS_HOST=redis
REDIS_PORT=6379

# ─── JWT / Token ───
TOKEN_SECRET_KEY=替换为随机32位字符串
APIKEY=替换为随机32位字符串

# ─── Bcrypt ───
SALTROUNDS=10

# ─── Snowflake ID ───
SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_CENTER_ID=1
SNOWFLAKE_EPOCH=1704067200000
SNOWFLAKE_STRING_MODE=true

# ─── LangGraph PostgreSQL Checkpoint ───
USE_LANGGRAPH=true
LANGGRAPH_RECURSION_LIMIT=8
AGENT_MAX_STEPS=3
LANGGRAPH_POSTGRES_HOST=postgres
LANGGRAPH_POSTGRES_PORT=5432
LANGGRAPH_POSTGRES_DATABASE=langgraph
LANGGRAPH_POSTGRES_USER=postgres
LANGGRAPH_POSTGRES_PASSWORD=postgres
LANGGRAPH_POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/langgraph

# ─── ChromaDB ───
CHROMA_URL=http://chroma:8000
CHROMA_COLLECTION=ecommerce_knowledge_base

# ─── LLM API Keys (必填!) ───
GLM_DASHSCOPE_API_KEY=替换为智谱API密钥
GLM_DASHSCOPE_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
MODEL_NAME=glm-4.5-air

QINIU_DASHSCOPE_API_KEY=替换为七牛API密钥
QINIU_DASHSCOPE_BASE_URL=https://api.qnaigc.com/v1

ALI_DASHSCOPE_API_KEY=替换为阿里百炼API密钥
ALI_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REPORT_MODEL_NAME=deepseek-v4-pro

BAISHAN_DASHSCOPE_API_KEY=替换为白山API密钥
BAISHAN_DASHSCOPE_BASE_URL=https://api.edgefn.net/v1

HUGGINGFACE_DASHSCOPE_API_KEY=替换为HuggingFace API密钥
HUGGINGFACE_DASHSCOPE_BASE_URL=https://router.huggingface.co/v1

VISION_MODEL_NAME=qwen/qwen3.5-35b-a3b

# ─── 七牛云对象存储 ───
QINIU_ACCESS_KEY=替换为七牛AccessKey
QINIU_SECRET_KEY=替换为七牛SecretKey
QINIU_BUCKET=new-rabbit-back
QINIU_DOMAIN=http://rabbit.fanblog.top

# ─── 邮箱 ───
SMTP_HOST=smtp.yeah.net
SMTP_PORT=465
EMAIL_ACCOUNT=fanfan0521@yeah.net
EMAIL_key=替换为邮箱授权码
EMAIL_SECURE=true

# ─── Rerank ───
RERANK_SCORE_THRESHOLD=0.5

# ─── 其它 ───
UAPIPRO_APIKEY=替换为UAPI密钥
TENCENT_OCR_SECRET_ID=替换为腾讯云SecretId
TENCENT_OCR_SECRET_KEY=替换为腾讯云SecretKey
